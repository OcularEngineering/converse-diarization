# Copy to .env. The CLI loads .env from the current directory without overriding
# variables that are already exported. Never commit the real file.
#
# `converse-diarization models add <name> --url <base url> --key <secret>` appends
# the matching <VENDOR>_API_KEY line here for you; models.toml only ever holds the
# variable NAME.

# Hugging Face token: read access to the Ocular AI dataset repos and to gated
# local checkpoints such as pyannote/speaker-diarization-community-1.
HF_TOKEN=

# OpenRouter: one key for every entry in models.toml marked "via OpenRouter"
# (https://openrouter.ai/settings/keys).
OPENROUTER_API_KEY=

# Direct vendor keys. Only needed for models you add with their own --url,
# or for vendors that are not on OpenRouter.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
